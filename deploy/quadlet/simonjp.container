[Unit]
Description=SimonJP Application
After=simonjp-postgres.service simonjp-valkey.service
Requires=simonjp-postgres.service simonjp-valkey.service

[Container]
# Build locally with `make podman-build`, or use the published image:
# Image=ghcr.io/simonjp/simonjp:latest
Image=simonjp:latest
ContainerName=simonjp-app
Network=simonjp.network
PublishPort=127.0.0.1:8080:8080
Environment=SERVER_PORT=8080
Environment=SPRING_DATASOURCE_URL=jdbc:postgresql://simonjp-postgres:5432/simonjp
Environment=SPRING_DATASOURCE_USERNAME=admin
Environment=SPRING_DATASOURCE_PASSWORD=admin
Environment=REDIS_HOST=simonjp-valkey
Environment=REDIS_PORT=6379
Environment=REDIS_PASSWORD=admin
Environment=APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
Environment=AUTH_COOKIE_SECURE=false
Environment=AUTH_COOKIE_SAME_SITE=Lax
# Uncomment to load secrets from a file instead of inline values:
# EnvironmentFile=%h/.config/simonjp/simonjp.env

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
