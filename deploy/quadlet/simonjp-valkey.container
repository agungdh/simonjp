[Unit]
Description=SimonJP Valkey
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/valkey/valkey:9.1
ContainerName=simonjp-valkey
Network=simonjp.network
Volume=simonjp-valkey.volume:/data
Exec=valkey-server --requirepass admin
PublishPort=127.0.0.1:6379:6379
HealthCmd=CMD-SHELL valkey-cli -a admin ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target
