# Optional environment overrides for the app container.
# Copy to ~/.config/simonjp/simonjp.env and uncomment EnvironmentFile= in simonjp.container.
SPRING_DATASOURCE_URL=jdbc:postgresql://simonjp-postgres:5432/simonjp
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
REDIS_HOST=simonjp-valkey
REDIS_PORT=6379
REDIS_PASSWORD=admin
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
